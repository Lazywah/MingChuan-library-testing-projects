# ==============================================================================
# 圖書館 AI 基地 — 環境變數單一真相範本 (.env.example)
# AI-Base Platform — Single Source of Truth for Environment Variables
# ==============================================================================
# 用法：複製本檔為 .env（同目錄），改完下方「換機只改這區」即可部署。
#   cp .env.example .env
# .env 已 gitignore，機敏值只放 .env、絕不進版控。
#
# 本檔涵蓋三個 compose 會用到的所有 key：
#   - docker-compose.yml            （job-scheduler 主服務）
#   - docker-compose.ai-models.yml  （open-webui / Portkey / 雲端 LLM）
#   - gpu-worker/docker-compose.yml （GPU worker，透過 `--env-file ../.env` 讀本檔）
# 每個 key 標註：〔必填〕啟動前一定要改 ／〔預設〕通常不用動 ／〔換機〕依主機而定。
# ==============================================================================


# ##############################################################################
# 🖊️  換機只改這區（其餘往下都有安全預設，通常不用動）
# ##############################################################################

# ── 1. 安全秘鑰〔必填〕──────────────────────────────────────────────────────
# 每個用 `openssl rand -hex 32` 各產一組不同的值。留 CHANGE_ME 會 fail-fast 拒絕啟動。
JWT_SECRET_KEY=CHANGE_ME            # 〔必填〕JWT 簽章金鑰，≥32 字元
SECRETS_MASTER_KEY=CHANGE_ME        # 〔必填〕使用者 secrets 的 AES-256 主金鑰，≥32 字元
                                    #   ⚠️ 上線後絕不可再改：一改所有已存的使用者 secrets 全部解不開
WORKER_API_TOKEN=CHANGE_ME          # 〔必填〕≥16 字元。gpu-worker 會用同一把（下方 gpu-worker 區不必再設）
                                    #   ⚠️ 兩邊不一致 → worker heartbeat/領工作全 401 且「無聲」
WEBUI_SECRET_KEY=CHANGE_ME          # 〔必填〕open-webui session 金鑰，建議 32+ 字元

# ── 2. SSO OIDC（IT 給憑證後才填；沒填＝維持關閉、走內建 mock）────────────────
# 詳見 docs/IT-OIDC-申請信範本.md。tenant_id 是公開值、放在 sso_policy.yaml，這裡不用設。
OIDC_CLIENT_ID=                     # 〔換機〕IT 給的 Application (client) ID
OIDC_CLIENT_SECRET=                 # 〔換機〕IT 給的 client secret 值（機敏）
OIDC_REDIRECT_URI=http://localhost/api/v1/sso/oidc/callback
                                    #   dev 用上面這行（走 nginx :80）；
                                    #   prod 改成 https://<正式主機名>/api/v1/sso/oidc/callback（須與 Entra 註冊逐字一致）

# ── 3. 廠商 / 郵件 / 雲端 LLM 憑據〔換機〕──────────────────────────────────────
# MYAI 廠商 headless 同步（唯讀）：用管理者帳密登入抓點數，程式不存明文、不存學生密碼。
MYAI_ADMIN_EMAIL=                   # 〔換機〕MYAI 管理者 email
MYAI_ADMIN_PASSWORD=                # 〔換機〕MYAI 管理者密碼（機敏）

# 雲端 LLM API Keys（經 Portkey；不用的留 placeholder 即可）
ANTHROPIC_API_KEY=sk-ant-placeholder
OPENAI_API_KEY=sk-placeholder
GOOGLE_API_KEY=placeholder
GAMMA_API_KEY=placeholder

# SMTP 寄信（登入/密碼通知；不寄信可全部留空）
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ai-platform.local

# ── 4. 對外來源 / 網域〔換機〕────────────────────────────────────────────────
# CORS 允許來源（逗號分隔）。dev 留空＝允許所有；prod 建議填正式網域。
# 範例：CORS_ORIGINS=https://ai.school.edu.tw
CORS_ORIGINS=


# ##############################################################################
# gpu-worker 區（GPU worker 專用；與 scheduler 同機時整區用預設即可）
# ##############################################################################
# 說明：gpu-worker 啟動時以 `docker compose --env-file ../.env up -d` 讀「本檔」。
#   worker 的 API_TOKEN 由上方 WORKER_API_TOKEN 自動帶入，這裡不必重設。
# 只有「GPU 在另一台主機」時才需要動 SERVICE_LAYER_URL；Linux 主機一定要改 STORAGE_MOUNT_PATH。

SERVICE_LAYER_URL=http://ai-platform-scheduler:8000
                                    # 〔預設〕同機用容器名即可（免猜 IP）。
                                    #   跨主機 GPU 才改成服務層真實位址，例：http://192.168.1.50:8002
STORAGE_MOUNT_PATH=C:\storage       # 〔換機〕訓練容器掛載的宿主機共享路徑（由宿主 Docker 解析）
                                    #   ⚠️ Linux 主機必須改成 Linux 絕對路徑（例 /mnt/storage）；留 C:\storage 會掛載失敗
NODE_ID=gpu-node-01                 # 〔換機〕此節點在儀表板顯示的名稱；多台各自命名
POOL_TYPE=batch                     # 〔預設〕batch＝一般/重量級；服務層 RTX 5090 那台設 interactive
GPU_IDLE_UTIL_THRESHOLD=90          # 〔預設〕GPU 空閒判定門檻(%)。桌機共用 GPU 用 90；專用 GPU 伺服器改低值(如 10)
POLL_INTERVAL=5                     # 〔預設〕領取任務輪詢間隔(秒)
HEARTBEAT_INTERVAL=30               # 〔預設〕心跳上報間隔(秒)


# ##############################################################################
# 以下皆有安全預設，一般部署不用動（進階調校 / 對照用）
# ##############################################################################

# ── JWT / 登入 ────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256                 # 〔預設〕
ACCESS_TOKEN_EXPIRE_MINUTES=120     # 〔預設〕登入 token 有效分鐘數

# ── 資料庫 ──────────────────────────────────────────────────────────────────
DATABASE_PATH=/data/ai_platform.db  # 〔預設〕容器內路徑，通常不動

# ── Token 額度 ──────────────────────────────────────────────────────────────
DEFAULT_MONTHLY_TOKEN_LIMIT=5000000 # 〔預設〕每月預設額度
TOKEN_RESET_DAY=1                   # 〔預設〕每月額度重置日
INTERNAL_TOKEN_ACCOUNTING=false     # 〔預設〕false＝不做內部 Token 計量（改顯示 MYAI 廠商點數）

# ── 任務排程 ──────────────────────────────────────────────────────────────────
JOB_TIMEOUT_MINUTES=120             # 〔預設〕單一任務逾時(分)

# ── Portkey / Ollama（LLM 閘道）────────────────────────────────────────────────
PORTKEY_URL=http://ai-platform-portkey:8787/v1/chat/completions   # 〔預設〕
PORTKEY_ENABLED=true                # 〔預設〕
OLLAMA_BASE_URL=http://ai-platform-ollama:11434                   # 〔預設〕本機 Ollama 位址

# ── RAG 客服小基（直接打 Ollama；需先 `ollama pull` 下列兩個模型）──────────────
RAG_EMBED_MODEL=nomic-embed-text    # 〔預設〕嵌入模型
RAG_CHAT_MODEL=qwen2.5:7b           # 〔預設〕回覆生成模型
RAG_TOP_K=4                         # 〔預設〕取前 k 個知識片段
RAG_MIN_SCORE=0.2                   # 〔預設〕相似度門檻（低於視為無關）
RAG_HISTORY_TURNS=3                 # 〔預設〕帶入最近幾輪對話

# ── MYAI 廠商同步（路徑/頻率；帳密在上面「換機」區）────────────────────────────
MYAI_BASE_URL=https://www.myai168.com                            # 〔預設〕
MYAI_LOGIN_PATH=/mcu/ai/user/login_info                          # 〔預設〕
MYAI_EXPORT_PATH=/mcu/gt_sdk/admin_168/user/export_user_list     # 〔預設〕
MYAI_SYNC_INTERVAL_HOURS=6          # 〔預設〕自動同步間隔(小時)；0=關閉自動
MYAI_TX_SYNC_DAYS=90                # 〔預設〕交易日誌每次回溯天數
MYAI_BALANCE_POLL_MINUTES=5         # 〔預設〕餘額輪詢間隔(分)；0=關閉
MYAI_BALANCE_POLL_DAYS=1            # 〔預設〕餘額輪詢回溯天數

# ── 日誌 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                      # 〔預設〕DEBUG / INFO / WARNING / ERROR


# ##############################################################################
# ⚠️ 已停用（舊 SSH 多節點架構遺留，現行程式碼零引用，可直接刪除）
# ##############################################################################
# 現行架構是「worker 主動領工作」，不再由 scheduler SSH 進 GPU 主機，故以下 key 全無作用。
# 保留於此僅為說明，確認無誤後可整段刪掉。
# GPU_MOCK_MODE=true
# GPU_SERVER_1_HOST=192.168.1.100
# GPU_SERVER_2_HOST=192.168.1.101
# GPU_SERVER_USERNAME=gpu_admin
# SSH_KEY_PATH=/root/.ssh/gpu_key
# MAX_CONCURRENT_JOBS=4
# JOB_CHECK_INTERVAL=10
