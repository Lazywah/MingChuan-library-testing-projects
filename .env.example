# ==============================================================================
# 圖書館 AI 基地 — 環境變數單一真相範本 (.env.example)
# AI-Base Platform — Single Source of Truth for Environment Variables
# ==============================================================================
# 用法：複製本檔為 .env（同目錄），改完下方「換機只改這區」即可部署。
#   cp .env.example .env
# .env 已 gitignore，機敏值只放 .env、絕不進版控。
#
# 本檔涵蓋三個 compose 會用到的所有 key：
#   - docker-compose.yml            （job-scheduler 主服務）
#   - docker-compose.ai-models.yml  （open-webui / Portkey / 雲端 LLM）
#   - gpu-worker/docker-compose.yml （GPU worker，透過 `--env-file ../.env` 讀本檔）
# 每個 key 標註：〔必填〕啟動前一定要改 ／〔預設〕通常不用動 ／〔換機〕依主機而定。
#
# ⚠️ 格式規則：`KEY=值` 的同一行「絕不」放註解 —— docker compose 與 pydantic 不會
#    剝掉行內 `#`，會把註解當成值的一部分（已實際踩過：tenant 變成註解亂碼）。
#    所有說明一律寫在 key 的上一行。
# ==============================================================================


# ##############################################################################
# 🖊️  換機只改這區（其餘往下都有安全預設，通常不用動）
# ##############################################################################

# ── 1. 安全秘鑰〔必填〕──────────────────────────────────────────────────────
# 每個用 `openssl rand -hex 32` 各產一組不同的值。留 CHANGE_ME 會 fail-fast 拒絕啟動。

# 〔必填〕JWT 簽章金鑰，≥32 字元
JWT_SECRET_KEY=CHANGE_ME

# 〔必填〕使用者 secrets 的 AES-256 主金鑰，≥32 字元
# ⚠️ 上線後絕不可再改：一改所有已存的使用者 secrets 全部解不開
SECRETS_MASTER_KEY=CHANGE_ME

# 〔必填〕≥16 字元。gpu-worker 會用同一把（下方 gpu-worker 區不必再設）
# ⚠️ 兩邊不一致 → worker heartbeat/領工作全 401 且「無聲」
WORKER_API_TOKEN=CHANGE_ME

# 〔必填〕open-webui session 金鑰，建議 32+ 字元
WEBUI_SECRET_KEY=CHANGE_ME

# ── 1.5 第一個管理員帳號（v3.3）────────────────────────────────────────────
# 平台預設沒有任何管理員。服務**首次啟動時**若偵測到「DB 內完全沒有 admin」，
# 會用下列密碼自動建立帳號 `admin`（已存在任何 admin 時則不會建立，也不會覆寫）。
# 由 `python scripts/setup_env.py` 互動設定；亦可手動填。
# ⚠️ 明文存放：與同檔的 JWT_SECRET_KEY 同等機密（該金鑰更強——可偽造任何人的登入）。
#    .env 已 gitignore。建立完成、登入改過密碼後，可自行把本值清空。
# ⚠️ 留空 = 不自動建立；屆時請用 scripts/create-admin.bat 手動建立。
BOOTSTRAP_ADMIN_PASSWORD=

# 管理員 Email（僅作紀錄，登入不需要）
BOOTSTRAP_ADMIN_EMAIL=admin@local

# ── 2. SSO OIDC（IT 給憑證後才填；沒填＝維持關閉、走內建 mock）────────────────
# ⚠ v3.1：MCU 走「自建 OIDC」auth.mcu.edu.tw（不是 Microsoft Entra）。
#   詳見 docs/IT-OIDC-申請信範本.md。

# 〔換機〕IT 給的 client_id
OIDC_CLIENT_ID=

# 〔換機〕IT 給的 client secret 值（機敏）
OIDC_CLIENT_SECRET=

# 〔換機〕dev 用下方預設值（走 nginx :80）；
# prod 改成 https://<正式主機名>/api/v1/sso/oidc/callback（須與 IdP 註冊逐字一致）
OIDC_REDIRECT_URI=http://localhost/api/v1/sso/oidc/callback

# 〔換機〕非機密。留空＝用 sso_policy.yaml 內建 auth.mcu.edu.tw；換 IdP 才覆寫
OIDC_DISCOVERY_URL=

# ── 3. 廠商 / 郵件 / 雲端 LLM 憑據〔換機〕──────────────────────────────────────
# MYAI 廠商 headless 同步（唯讀）：用管理者帳密登入抓點數，程式不存明文、不存學生密碼。

# 〔換機〕MYAI 管理者 email
MYAI_ADMIN_EMAIL=

# 〔換機〕MYAI 管理者密碼（機敏）
MYAI_ADMIN_PASSWORD=

# 雲端 LLM API Keys（經 Portkey；不用的留 placeholder 即可）
ANTHROPIC_API_KEY=sk-ant-placeholder
OPENAI_API_KEY=sk-placeholder
GOOGLE_API_KEY=placeholder
GAMMA_API_KEY=placeholder

# SMTP 寄信（登入/密碼通知；不寄信可全部留空）
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ai-platform.local

# ---- v3.5 退信回收（選用）------------------------------------------------
# ZH: 讀「我們自己的寄件信箱」把非同步退信抓回來，回填 email_log。
#     留空則沿用上面的 SMTP 帳密、主機由 SMTP_SERVER 推導(smtp.→imap.)。
#     全部留空 = 不啟用（寄信照常，只是看不到退信）。
#     Gmail：需應用程式密碼且該帳號已開啟 IMAP。
IMAP_SERVER=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ── 4. 對外來源 / 網域〔換機〕────────────────────────────────────────────────
# CORS 允許來源（逗號分隔）。dev 留空＝允許所有；prod 建議填正式網域。
# 範例：CORS_ORIGINS=https://ai.school.edu.tw
CORS_ORIGINS=


# ##############################################################################
# gpu-worker 區（GPU worker 專用；與 scheduler 同機時整區用預設即可）
# ##############################################################################
# 說明：gpu-worker 由 gpu-worker/start-worker.sh(.bat) 啟動，會自動帶
#   `--env-file ../.env` 讀「本檔」。worker 的 API_TOKEN 由上方 WORKER_API_TOKEN
#   自動帶入，這裡不必重設。
# 只有「GPU 在另一台主機」時才需要動 SERVICE_LAYER_URL；Linux 主機一定要改 STORAGE_MOUNT_PATH。

# 〔預設〕同機用容器名即可（免猜 IP）。
# 跨主機 GPU 才改成服務層真實位址，例：http://192.168.1.50:8002
SERVICE_LAYER_URL=http://ai-platform-scheduler:8000

# 〔換機〕訓練容器掛載的宿主機共享路徑（由宿主 Docker 解析）
# ⚠️ Linux 主機必須改成 Linux 絕對路徑（例 /mnt/storage）；留 C:\storage 會掛載失敗
STORAGE_MOUNT_PATH=C:\storage

# 〔換機〕此節點在儀表板顯示的名稱；多台各自命名
NODE_ID=gpu-node-01

# 〔預設〕batch＝一般/重量級；服務層 RTX 5090 那台設 interactive
POOL_TYPE=batch

# 〔換機〕此 GPU 節點是否與服務層**同一台機器**。
# 為什麼有這個開關：程式實驗室（Notebook）的任務要讀使用者的 home_<uid> Docker volume，
# 而 Docker volume 是本機的。GPU 換到別台機器後，docker 會在那台**自動建立一個空的**同名
# volume——不報錯、資料不在、訓練出沒有意義的結果。設 false 時服務層就不派這類任務過來。
# ⚠️ GPU 搬到獨立主機時**一定要改成 false**（本範本預設 true＝單機部署）
SHARES_SERVICE_STORAGE=true

# ── GPU 主機的共享儲存回收 ──────────────────────────────────────────────
# 這台機器上沒有任何配額擋著（服務層那側有每人 2 GB，這裡沒有）。
# 資料集快取與訓練產出不清會一路長到磁碟滿，症狀是「訓練突然全部失敗」。
# 〔預設〕總開關；關掉就完全不清（只有你自己有別的清理機制時才關）
REAP_ENABLED=true
# 〔預設〕多久掃一次(小時)
REAP_INTERVAL_HOURS=6
# 〔預設〕資料集快取保留天數。重跑同一包資料在這天數內仍是快取命中
DATASET_TTL_DAYS=14
# 〔換機〕資料集快取總量上限(GB)。**依這台機器的磁碟大小調**；超過就 LRU 淘汰
DATASET_CACHE_MAX_GB=100
# 〔預設〕訓練產出保留天數。目前還不能從畫面下載，所以留久一點
OUTPUT_TTL_DAYS=30
# 〔預設〕安全底線(小時)：不論 TTL 或容量怎麼算，這麼新的東西一律不刪
#         —— 這是「不要刪到正在訓練的資料」的最後一道防線
REAP_MIN_AGE_HOURS=24

# ── 私有 Docker Registry（只有多機部署才需要）─────────────────────────────
# 為什麼會需要：aibase/* 映像是在服務層這台機器上建出來的，不在任何公開 registry。
# GPU 搬到獨立主機之後那台拉不到，而「程式實驗室」與「上傳訓練」都指向這些映像，
# 會一起停擺。做法：在服務層跑一個 registry，把映像推上去，GPU 主機從那裡拉。
#
# 啟動（單機部署不需要）：
#   bash infrastructure/registry/make-htpasswd.sh      # 產生帳密檔
#   docker compose --profile registry up -d registry
#   bash infrastructure/base-images/push-all.sh
#
# ⚠️ 沒有帳密的 registry 等於讓任何人把映像推進來，而那些映像會在你的機器上
#    以 --gpus 執行。所以 REGISTRY_PASSWORD 沒設時 registry 會直接啟動失敗。
# 〔換機〕registry 的帳號密碼（服務層與各 GPU 主機要一致）
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# 〔換機〕registry 對外綁定位址。預設只綁本機；要讓遠端 GPU 主機連進來時，
#         **建議走 nginx 的 TLS**，不要把這個埠直接開到網路上（明文會送帳密）
REGISTRY_BIND=127.0.0.1
# 〔換機〕**只有與服務層不同機的 GPU 節點要填**（例 registry.mcu.edu.tw 或 192.168.1.50:5000）
#         留空＝用本機映像，就是單機部署的情形
IMAGE_REGISTRY_PREFIX=

# 〔預設〕GPU 空閒判定門檻(%)。桌機共用 GPU 用 90；專用 GPU 伺服器改低值(如 10)
GPU_IDLE_UTIL_THRESHOLD=90

# 〔預設〕領取任務輪詢間隔(秒)
POLL_INTERVAL=5

# 〔預設〕心跳上報間隔(秒)
HEARTBEAT_INTERVAL=30


# ##############################################################################
# 以下皆有安全預設，一般部署不用動（進階調校 / 對照用）
# ##############################################################################

# ── JWT / 登入 ────────────────────────────────────────────────────────────────
# 〔預設〕
JWT_ALGORITHM=HS256
# 〔預設〕登入 token 有效分鐘數
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── 資料庫 ──────────────────────────────────────────────────────────────────
# 〔預設〕容器內路徑，通常不動
DATABASE_PATH=/data/ai_platform.db

# ── Token 額度 ──────────────────────────────────────────────────────────────
# 〔預設〕每月預設額度
DEFAULT_MONTHLY_TOKEN_LIMIT=5000000
# 〔預設〕每月額度重置日
TOKEN_RESET_DAY=1
# 〔預設〕false＝不做內部 Token 計量（改顯示 MYAI 廠商點數）
INTERNAL_TOKEN_ACCOUNTING=false

# ── 任務排程 ──────────────────────────────────────────────────────────────────
# 〔預設〕單一任務逾時(分)
JOB_TIMEOUT_MINUTES=120

# ZH: 公告附件的上限。兩個都可以在管理端的「系統設定」裡改，
#     這裡只是沒設定過時的預設值。
# ZH: 總量是**全站的**，不是每人的 —— 附件是管理員放的，
#     算到學生的個人配額上是錯的。
ANNOUNCEMENT_FILE_MAX_MB=20
ANNOUNCEMENT_FILES_TOTAL_GB=2

# ── Portkey / Ollama（LLM 閘道）────────────────────────────────────────────────
# 〔預設〕
PORTKEY_URL=http://ai-platform-portkey:8787/v1/chat/completions
# 〔預設〕
PORTKEY_ENABLED=true
# 〔預設〕本機 Ollama 位址
OLLAMA_BASE_URL=http://ai-platform-ollama:11434

# ── RAG 客服小基（直接打 Ollama；需先 `ollama pull` 下列兩個模型）──────────────
# 〔預設〕嵌入模型
RAG_EMBED_MODEL=bge-m3
# 〔預設〕回覆生成模型
RAG_CHAT_MODEL=llama3
# 〔預設〕取前 k 個知識片段
RAG_TOP_K=4
# 〔預設〕相似度門檻（低於視為無關）
RAG_MIN_SCORE=0.2
# 〔預設〕帶入最近幾輪對話
RAG_HISTORY_TURNS=3

# ── MYAI 廠商同步（路徑/頻率；帳密在上面「換機」區）────────────────────────────
# 〔預設〕
MYAI_BASE_URL=https://www.myai168.com
# 〔預設〕
MYAI_LOGIN_PATH=/mcu/ai/user/login_info
# 〔預設〕
MYAI_EXPORT_PATH=/mcu/gt_sdk/admin_168/user/export_user_list
# 〔預設〕自動同步間隔(小時)；0=關閉自動
MYAI_SYNC_INTERVAL_HOURS=6
# 〔預設〕交易日誌每次回溯天數
MYAI_TX_SYNC_DAYS=90
# 〔預設〕餘額輪詢間隔(分)；0=關閉
MYAI_BALANCE_POLL_MINUTES=5
# 〔預設〕餘額輪詢回溯天數
MYAI_BALANCE_POLL_DAYS=1

# ── 日誌 ────────────────────────────────────────────────────────────────────
# 〔預設〕DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO


# ##############################################################################
# ⚠️ 已停用（舊 SSH 多節點架構遺留，現行程式碼零引用，可直接刪除）
# ##############################################################################
# 現行架構是「worker 主動領工作」，不再由 scheduler SSH 進 GPU 主機，故以下 key 全無作用。
# 保留於此僅為說明，確認無誤後可整段刪掉。
# GPU_MOCK_MODE=true
# GPU_SERVER_1_HOST=192.168.1.100
# GPU_SERVER_2_HOST=192.168.1.101
# GPU_SERVER_USERNAME=gpu_admin
# SSH_KEY_PATH=/root/.ssh/gpu_key
# MAX_CONCURRENT_JOBS=4
# JOB_CHECK_INTERVAL=10
