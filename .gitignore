# ==============================================================================
# ZH: AI 訓練平台 - Git 忽略規則
# EN: AI Training Platform - Git Ignore Rules
# ==============================================================================

# ZH: 環境變數 (含敏感資訊) | EN: Environment variables (contains secrets)
.env

# ZH: SQLite 資料庫檔案 | EN: SQLite database files
**/data/*.db
**/data/*.db-wal
**/data/*.db-shm

# ZH: MYAI 廠商 session cookie 快取（機敏、執行期產生，勿進版控）| EN: cached vendor session cookie (sensitive, runtime)
**/data/myai_session.json

# ZH: 使用者上傳的資料集 —— **絕不進版控**。
#     這條是被真實事件逼出來的（2026-08-20）：我做的測試資料集被 commit 進去了，
#     而同一條路徑在正式環境裝的是學生上傳的檔案。
# EN: User-uploaded datasets must never be committed.
**/data/datasets/

# ZH: 私有 registry 的帳密檔（bcrypt 雜湊，仍然不該進版控）
infrastructure/registry/auth/

# ZH: Python 快取 | EN: Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ZH: 虛擬環境 | EN: Virtual environments
.venv/
venv/
env/

# ZH: IDE 設定 | EN: IDE settings
.vscode/
.idea/
*.swp
*.swo

# ZH: 作業系統產生的檔案 | EN: OS generated files
.DS_Store
Thumbs.db

# ZH: Docker 產生的暫存 | EN: Docker generated temp files
*.log

# ZH: 備份檔案 | EN: Backup files
backups/

# ZH: setup_env.py 自動備份的舊版 .env | EN: .env backups created by setup_env.py
*.env.bak_*

# ZH: 開發中的紀錄文件 | EN: Log files under development
commit.txt
docs/dev
