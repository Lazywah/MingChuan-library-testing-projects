# ==============================================================================
# GPU Worker 設定範本（遠端節點用）/ Remote GPU worker env template
# ------------------------------------------------------------------------------
# 用法 / Usage：
#   1. 複製這個檔：      cp worker.env.example worker.env
#      （Windows：      copy worker.env.example worker.env）
#   2. 把下面標了 ← 改我 的幾行填好
#   3. 啟動：            WORKER_ENV_FILE=./worker.env ./start-worker.sh
#      （Windows：      set WORKER_ENV_FILE=worker.env  然後  start-worker.bat）
#
# 為什麼有這一份，而不是叫你複製根目錄的 .env.example ——
#   根 .env.example 有 266 行，是**整個平台**的設定，而且它的預設值是給
#   「與服務層同一台」用的。遠端節點只需要下面這十來行，而且其中三個鍵的
#   正確值和根範本**相反**。照抄根範本最惡毒的一項是 SHARES_SERVICE_STORAGE
#   （見下方說明），錯了完全不報錯，只是訓練結果沒有意義。
#
# 這幾項填錯的話，worker 開機時會**大聲拒絕啟動**並說明原因
#   （見 worker.py::validate_config），不會帶著錯的設定跑起來。
# ==============================================================================

# ── 服務層位址 ────────────────────────────────────────────────────────────────
# ⚠ 不可以填 ai-platform-scheduler —— 那是 compose 網路裡的**容器內部名**，
#   只有和服務層同一台 docker 才解析得到。遠端節點要填真實 IP 或主機名。
#   埠是 8002（服務層對外的埠，不是容器內的 8000）。
SERVICE_LAYER_URL=http://192.168.1.101:8002          # ← 改我

# ── 認證 ─────────────────────────────────────────────────────────────────────
# 與服務層「根 .env」的 WORKER_API_TOKEN **逐字元相同**。
# ⚠ 服務層那邊的鍵名是 WORKER_API_TOKEN（不是 API_TOKEN）；抄錯鍵名的症狀是
#   每一次 heartbeat / take 都 401。
WORKER_API_TOKEN=CHANGE_ME                           # ← 改我

# ── 這台節點的身分 ────────────────────────────────────────────────────────────
# ⚠ 每一台都要不一樣。兩台同名會互相蓋寫心跳，admin 看到的是一台忽快忽慢的節點。
#   建議用看得懂的名字，例如 taipei-ws-07 / taipei-gpu-02。
NODE_ID=CHANGE_ME                                    # ← 改我

# batch＝排隊跑訓練（工作站與一般 GPU 伺服器都用這個）
# interactive＝服務層那台自己起的 worker 才用
POOL_TYPE=batch

# ── 🔴 這一行填錯不會報錯，但結果會是錯的 ─────────────────────────────────────
# 遠端節點**一定是 false**。
# 填 true 的話，服務層會把「程式實驗室」的任務派過來，而那些任務要讀使用者的
# home_<uid> Docker volume —— 那個 volume 在服務層那台。docker 會在**這台**
# 自動建一個同名的**空 volume**：不報錯、訓練照跑、照回報成功，
# 只是讀到的是空目錄，使用者拿到一個沒有意義的模型。
# （根 .env.example 的預設值是 true，因為那份是給同機部署用的。）
SHARES_SERVICE_STORAGE=false

# ── 這台宿主機的共享儲存路徑 ──────────────────────────────────────────────────
# ⚠ 這個目錄要**先自己建好**。交給 docker 自己建的話擁有者會是 root，
#   之後 worker（非 root）要清理或讀產出就會踩到權限。
#   Windows： mkdir C:\storage
#   Linux：   sudo mkdir -p /srv/aibase-storage && sudo chown $USER /srv/aibase-storage
STORAGE_MOUNT_PATH=C:\storage                        # ← Linux 要改成 POSIX 路徑

# 資料集快取上限，依這台機器的磁碟大小調。
# ⚠ 這一側**沒有任何配額擋著**（服務層那邊有每人 2 GB，這裡沒有）。
#   不清會一路長到磁碟滿，而症狀是「訓練突然全部失敗」。
DATASET_CACHE_MAX_GB=100

# ── 私有 registry ────────────────────────────────────────────────────────────
# aibase/* 映像只在服務層那台建出來，不在任何公開 registry。遠端節點要從這裡拉。
# 留空＝用本機已有的映像（只有在你手動 docker load 過才行）。
# ⚠ 明文 HTTP 的 registry 還要在這台的 docker daemon 設定加 insecure-registries，
#   見 README「遠端 GPU 主機」一節。正式環境建議走 TLS，不要用明文送帳密。
IMAGE_REGISTRY_PREFIX=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ── 選填：GPU 空閒判定門檻(%) ─────────────────────────────────────────────────
# 90 適合「有人在用的桌機」（GPU 與 OS / 瀏覽器共用，常態就有負載）。
# 專用 GPU 伺服器可以調回低值（例如 10），讓它只在真的閒著時才領工作。
GPU_IDLE_UTIL_THRESHOLD=90
